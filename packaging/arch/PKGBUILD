# Development recipe for a local source tarball; no proprietary artifacts.
pkgname=linux-scrollmaster
pkgver=0.3.0
pkgrel=1
pkgdesc='Configurador independiente para Logitech MX Master 3S'
arch=('x86_64')
license=('GPL-3.0-or-later' 'CC-BY-NC-SA-4.0')
depends=('python' 'solaar=1.1.20' 'gtk3' 'webkit2gtk-4.1' 'openssl' 'wayland' 'libxkbcommon' 'libayatana-appindicator')
makedepends=('rust' 'nodejs' 'pnpm' 'base-devel' 'pkgconf')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP') # Local development only; replace with checksum before release.
build() {
  cd "$srcdir/$pkgname-$pkgver"
  pnpm install --frozen-lockfile
  pnpm tauri build --no-bundle
}
package() {
  cd "$srcdir/$pkgname-$pkgver"
  install -Dm755 src-tauri/target/release/linux-scrollmaster "$pkgdir/usr/bin/linux-scrollmaster"
  for module in service model solaar_adapter modifiers actions profiles gestures desktop; do
    install -Dm644 "bridge/$module.py" "$pkgdir/usr/lib/linux-scrollmaster/bridge/$module.py"
  done
  install -Dm755 bridge/libscrollmaster-keyboard.so "$pkgdir/usr/lib/linux-scrollmaster/bridge/libscrollmaster-keyboard.so"
  install -Dm644 packaging/arch/linux-scrollmaster.desktop "$pkgdir/usr/share/applications/linux-scrollmaster.desktop"
  install -Dm644 src-tauri/icons/icon.png "$pkgdir/usr/share/icons/hicolor/128x128/apps/linux-scrollmaster.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/linux-scrollmaster/LICENSE"
  install -Dm644 src/mouse3d/ASSETS-LICENSE.md "$pkgdir/usr/share/licenses/linux-scrollmaster/ASSETS-LICENSE.md"
}
