{
  "$schema": "https://schema.tauri.app/config/2",
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "Independent Logitech MX Master 3S configurator",
    "longDescription": "Tune DPI, wheels and buttons of the Logitech MX Master 3S, assign shortcuts and gestures, and switch profiles per application on Hyprland. Native HID++ backend, no account, no cloud. English and Spanish interface. Not affiliated with Logitech.",
    "license": "GPL-3.0-or-later AND CC-BY-NC-SA-4.0",
    "resources": null,
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/udev/rules.d/70-linux-scrollmaster.rules": "../packaging/udev/70-linux-scrollmaster.rules",
          "/usr/share/doc/linux-scrollmaster/ASSETS-LICENSE.md": "../src/mouse3d/ASSETS-LICENSE.md"
        }
      },
      "rpm": {
        "depends": [
          "libayatana-appindicator-gtk3"
        ],
        "files": {
          "/usr/lib/udev/rules.d/70-linux-scrollmaster.rules": "../packaging/udev/70-linux-scrollmaster.rules",
          "/usr/share/doc/linux-scrollmaster/ASSETS-LICENSE.md": "../src/mouse3d/ASSETS-LICENSE.md"
        }
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
